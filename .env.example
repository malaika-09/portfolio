# Environment Configuration Template
# Copy this file to .env.local for local development
# For production deployment on Vercel, set these in the Vercel dashboard

# ============================================
# APPLICATION
# ============================================

# Node environment (development, production, test)
NODE_ENV=production

# Base URL for the application (used for SEO, API calls, etc.)
# Local development: http://localhost:3000
# Production: https://your-domain.vercel.app
NEXT_PUBLIC_APP_URL=https://your-domain.vercel.app

# Application name displayed in browser tab and SEO
NEXT_PUBLIC_APP_NAME="Robotics Portfolio"

# ============================================
# AUTHENTICATION
# ============================================

# Session secret for JWT signing (generate a secure random string)
# Generate with: openssl rand -base64 32
SESSION_SECRET=your-super-secret-session-key-change-this-in-production

# Session expiration time in seconds (default: 7 days)
SESSION_EXPIRE_TIME=604800

# Admin credentials (for initial setup)
# Change these immediately after first login
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-secure-password

# ============================================
# RATE LIMITING
# ============================================

# Maximum requests per window for API endpoints
RATE_LIMIT_MAX_REQUESTS=100

# Time window for rate limiting in seconds (default: 15 minutes)
RATE_LIMIT_WINDOW_SECONDS=900

# Maximum contact form submissions per IP per hour
CONTACT_RATE_LIMIT=5

# ============================================
# FILE UPLOAD
# ============================================

# Maximum file upload size in bytes (default: 10MB)
MAX_FILE_UPLOAD_SIZE=10485760

# Allowed file extensions for media uploads (comma-separated)
ALLOWED_FILE_EXTENSIONS=jpg,jpeg,png,gif,webp,avif,svg,mp4,webm,pdf,doc,docx

# Maximum number of files per upload
MAX_FILES_PER_UPLOAD=10

# ============================================
# EMAIL (OPTIONAL - for contact form notifications)
# ============================================

# SMTP server configuration (optional)
# If not configured, contact form will store messages in database only
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password

# Email addresses
EMAIL_FROM=noreply@your-domain.com
EMAIL_TO=admin@your-domain.com

# ============================================
# ANALYTICS (OPTIONAL)
# ============================================

# Google Analytics tracking ID (optional)
NEXT_PUBLIC_GA_TRACKING_ID=

# Vercel Analytics (automatically enabled on Vercel)
NEXT_PUBLIC_VERCEL_ANALYTICS_ID=

# ============================================
# SECURITY
# ============================================

# Content Security Policy mode (report-only or enforce)
CSP_MODE=enforce

# Allowed domains for external resources (comma-separated)
CSP_ALLOWED_DOMAINS=

# ============================================
# PERFORMANCE
# ============================================

# Enable image optimization
ENABLE_IMAGE_OPTIMIZATION=true

# Image optimization quality (1-100)
IMAGE_QUALITY=80

# Enable experimental features
ENABLE_EXPERIMENTAL_FEATURES=false

# ============================================
# LOGGING
# ============================================

# Log level (error, warn, info, debug)
LOG_LEVEL=error

# Enable error reporting to console in production
ENABLE_ERROR_LOGGING=true

# External error tracking service URL (optional)
# For services like Sentry, LogRocket, etc.
ERROR_TRACKING_URL=

# Public error tracking URL (for client-side errors)
NEXT_PUBLIC_ERROR_TRACKING_URL=

# ============================================
# DATA STORAGE
# ============================================

# Database connection string (for future PostgreSQL migration)
# DATABASE_URL=postgresql://user:password@host:5432/database

# ============================================
# DATA STORAGE
# ============================================

# Database (Neon PostgreSQL) - REQUIRED FOR PRODUCTION
# Get database URL from: https://console.neon.tech
# Format: postgres://user:password@host/database?sslmode=require
DATABASE_URL=your_neon_database_url_here
POSTGRES_URL=your_neon_database_url_here

# Data directory path (optional - for custom deployment environments)
# The application stores JSON data files (projects, blog posts, etc.) in this directory
# 
# Default behavior (when DATA_DIR is not set):
#   - Development: Uses ./data directory in project root
#   - Production standalone builds: Checks .next/standalone/data first, falls back to ./data
#
# Set this variable if:
#   - Your hosting platform requires data in a specific location
#   - You're using Docker with a mounted volume
#   - You want to use a network-attached storage path
#   - The default paths don't work in your deployment environment
#
# Examples:
#   DATA_DIR=./data                    # Relative path from application root
#   DATA_DIR=/var/data/portfolio       # Absolute path (Linux/macOS)
#   DATA_DIR=C:\app\data              # Absolute path (Windows)
#   DATA_DIR=/mnt/efs/data            # AWS EFS mount point
#   DATA_DIR=/mnt/azure-files/data    # Azure Files mount point
#
# Notes:
#   - Path can be relative or absolute
#   - Directory will be created automatically if it doesn't exist
#   - Ensure the application has read/write permissions
#   - For production, ensure data persists across deployments
#
# DATA_DIR=./data

# ============================================
# VERCEL-SPECIFIC
# ============================================

# These are automatically set by Vercel - do not set manually
# VERCEL=1
# VERCEL_ENV=production
# VERCEL_URL=your-project.vercel.app
# VERCEL_GIT_COMMIT_SHA=
# VERCEL_GIT_COMMIT_REF=
